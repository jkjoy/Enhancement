# QQ 开放平台的机器人应用凭据；AppSecret 只保存在本服务。
QQ_APP_ID=replace-with-your-app-id
QQ_APP_SECRET=replace-with-your-app-secret

# 必填，至少 32 个字符。运行下列命令生成，然后填入：
# python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_API_TOKEN=

# 可选：QQ 私聊发布瞬间。两个变量须同时填写，留空则只发送通知。
# 从 Enhancement 后台复制完整的官方服务回调地址；支持内网 HTTP 或 HTTPS。
ENHANCEMENT_WEBHOOK_URL=

# 与插件「QQ 瞬间回调密钥」一致的独立随机密钥，32 至 1024 位可见 ASCII。
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ENHANCEMENT_COMMAND_SECRET=

# 容器内目录和端口；compose.yaml 固定这两个值。
BOT_DATA_DIR=/data
BOT_PORT=8080
